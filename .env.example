# Public site URL (local + Vercel). Production: https://your-domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth — required for real GitHub/Google sign-in
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Extra origins/hosts after a custom domain is attached (comma-separated).
# Vercel previews (*.vercel.app) are already trusted in code.
# BETTER_AUTH_TRUSTED_ORIGINS=https://www.example.com
# BETTER_AUTH_ALLOWED_HOSTS=example.com,www.example.com

# Supabase Postgres — optional for local demo.
# If these are empty, the directory loads data/seed-bots.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# GitHub OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X / Twitter is not enabled. Better Auth supports a twitter provider, but it
# needs a separate X developer app and secrets — skip unless you add that wiring.

# Google Tag Manager container (omit to skip loading gtm.js)
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Search Console / 서치어드바이저 HTML meta tokens (public by design)
# GOOGLE_SITE_VERIFICATION=
# NAVER_SITE_VERIFICATION=

# IndexNow key for Bing/Yandex/Brave-shared URL pings (8–128 chars: A–Z a–z 0–9 -)
# Serves https://<host>/<INDEXNOW_KEY>.txt after a production rebuild.
# INDEXNOW_KEY=
