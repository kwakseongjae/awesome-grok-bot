# Public site URL (local + Vercel)
# Production: https://getgrokbot.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth — required for real GitHub/Google sign-in
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Neon Postgres (pooled connection string). Server-only — never prefix with NEXT_PUBLIC_.
# Better Auth sessions, setup-bot reviews, and /visitors writes.
# Catalog still renders from data/seed-bots.json when this is empty.
# Reviews/visitors: apply db/migrations/20260827000001_visitor_posts.sql on Neon.
DATABASE_URL=

# Optional Supabase JS — listing copy persistence only. Not used for reviews/visitors.
# If empty, the directory loads data/seed-bots.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X / Twitter is not enabled. Better Auth supports a twitter provider, but it
# needs a separate X developer app and secrets — skip unless you add that wiring.

# Search / analytics — paste values from each console, then redeploy.
# GTM-XXXX loads GTM only. If GTM is set, add the GA4 tag inside GTM (do not also set G-XXXX here).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional. If set, POST /api/indexnow and cron require Authorization: Bearer <secret>.
INDEXNOW_SUBMIT_SECRET=
