# Public site URL (local + Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth — required for real GitHub/Google sign-in
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Supabase Postgres — optional for local demo.
# If these are empty, the directory loads data/seed-bots.json.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# GitHub OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X / Twitter is not enabled. Better Auth supports a twitter provider, but it
# needs a separate X developer app and secrets — skip unless you add that wiring.
