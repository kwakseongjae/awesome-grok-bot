# Public site URL (local + Vercel)
# Production: https://getgrokbot.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth — required for real GitHub/Google sign-in
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# Neon Postgres (pooled). Optional for local demo.
# If empty, the directory loads data/seed-bots.json.
# Reviews, visitor marks, listing writes, and Better Auth need DATABASE_URL
# plus db/migrations (see db/README.md). Do not commit this value.
DATABASE_URL=

# GitHub OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (Better Auth callback: {BETTER_AUTH_URL}/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# X / Twitter is not enabled. Better Auth supports a twitter provider, but it
# needs a separate X developer app and secrets — skip unless you add that wiring.

# Search / analytics — paste values from each console, then redeploy.
# Vercel Web Analytics is in the root layout (@vercel/analytics). Enable it
# on the Vercel project. Do not invent a return-rate number on the site.
# GTM-XXXX loads GTM only. If GTM is set, add the GA4 tag inside GTM (do not also set G-XXXX here).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional. If set, POST /api/indexnow and cron require Authorization: Bearer <secret>.
INDEXNOW_SUBMIT_SECRET=
